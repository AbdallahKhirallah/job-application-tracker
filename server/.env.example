# Copy this file to .env and fill in your values. Never commit .env to git.

# Required: secret for signing JWTs (use a long random string, e.g. 64+ chars)
JWT_SECRET=your-super-secret-key-at-least-32-characters-long

# Server
PORT=5000

# Frontend URL (for CORS). Use your production URL in production.
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=job_tracker

# Optional: set to 'production' to hide error details in API responses
NODE_ENV=development
