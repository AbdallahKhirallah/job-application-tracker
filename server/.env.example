# Copy this file to .env and fill in your values. Never commit .env to git.

# Required: secret for signing JWTs (use a long random string, e.g. 64+ chars)
JWT_SECRET=your-super-secret-key-at-least-32-characters-long

# Server
PORT=5000

# Frontend URL(s) for CORS. Single origin, or comma-separated list in production.
# e.g. FRONTEND_URL=https://trackjat.me,https://www.trackjat.me
FRONTEND_URL=http://localhost:5173

# PostgreSQL — local development (discrete vars)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=job_tracker

# PostgreSQL — production. If set, this single connection string is used instead
# of the DB_* vars above (Railway / Neon / Render).
# DATABASE_URL=postgresql://user:password@host/dbname
# SSL is auto-enabled for public hosts and disabled for *.railway.internal.
# Force it either way if needed:
# DATABASE_SSL=true

# Shared secret for the external reminder trigger: POST /api/cron/reminders
# with header  x-cron-secret: <this value>  (used on hosts that sleep).
# CRON_SECRET=some-long-random-string

# Optional: set to 'production' to hide error details in API responses
NODE_ENV=development
